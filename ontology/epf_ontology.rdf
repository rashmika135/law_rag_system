  <rdf:Description rdf:about="http://example.org/epf#CalculationRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Calculation Rule</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/epf#ComplianceConcept"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#InterestRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Interest Rule</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/epf#ComplianceConcept"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#AccountRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Individual Account Rule</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/epf#ComplianceConcept"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://example.org/epf#ContributionRounding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#CalculationRule"/>
    <rdfs:label>Rounding of Contribution Fractions</rdfs:label>
    <epf:definedIn rdf:resource="http://example.org/epf#Section13"/>
    <skos:altLabel>round contribution amount</skos:altLabel>
    <skos:altLabel>rounding EPF contribution</skos:altLabel>
    <skos:altLabel>fraction of a cent in contribution</skos:altLabel>
    <skos:altLabel>ignore fraction less than half a cent</skos:altLabel>
    <skos:altLabel>reckon half a cent or more as one cent</skos:altLabel>
    <skos:altLabel>contribution fraction rounding rule</skos:altLabel>
    <epf:relatedTo rdf:resource="http://example.org/epf#MonthlyContributionPayment"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://example.org/epf#FundInterest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#InterestRule"/>
    <rdfs:label>Interest on EPF Contributions and Individual Account Balance</rdfs:label>
    <epf:definedIn rdf:resource="http://example.org/epf#Section14"/>
    <skos:altLabel>EPF interest</skos:altLabel>
    <skos:altLabel>interest on contributions</skos:altLabel>
    <skos:altLabel>interest on individual account</skos:altLabel>
    <skos:altLabel>annual interest on EPF balance</skos:altLabel>
    <skos:altLabel>interest rate on member account</skos:altLabel>
    <skos:altLabel>minimum two and a half percent interest</skos:altLabel>
    <epf:relatedTo rdf:resource="http://example.org/epf#IndividualAccountCredit"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://example.org/epf#IndividualAccountCredit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#AccountRule"/>
    <rdfs:label>Crediting Contributions and Interest to Individual Member Account</rdfs:label>
    <epf:definedIn rdf:resource="http://example.org/epf#Section18"/>
    <skos:altLabel>credit contributions to individual account</skos:altLabel>
    <skos:altLabel>credit employer contribution to member account</skos:altLabel>
    <skos:altLabel>credit employee contribution to member account</skos:altLabel>
    <skos:altLabel>credit interest to individual account</skos:altLabel>
    <skos:altLabel>member EPF account credit</skos:altLabel>
    <skos:altLabel>contributions and interest credited to member account</skos:altLabel>
  </rdf:Description>
</rdf:RDF>
