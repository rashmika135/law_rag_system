    <epf:hasSection rdf:resource="http://example.org/epf#Section15"/>
    <epf:hasSection rdf:resource="http://example.org/epf#Section16"/>
    <epf:hasSection rdf:resource="http://example.org/epf#Section17"/>
    <epf:hasSection rdf:resource="http://example.org/epf#Section18"/>
    <epf:hasSection rdf:resource="http://example.org/epf#Section19"/>
    <epf:hasSection rdf:resource="http://example.org/epf#Section20"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#Section13">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#LegalSection"/>
    <rdfs:label>Section 13</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#Section16">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#LegalSection"/>
    <rdfs:label>Section 16</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#hasConsequence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has consequence</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/epf#ComplianceConcept"/>
    <rdfs:range rdf:resource="http://example.org/epf#ComplianceConcept"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#LateContributionSurcharge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#PenaltyRule"/>
    <rdfs:label>Surcharge for Late EPF Contribution Payment</rdfs:label>
    <epf:definedIn rdf:resource="http://example.org/epf#Section16"/>
    <skos:altLabel>late EPF payment</skos:altLabel>
    <skos:altLabel>late contribution penalty</skos:altLabel>
    <skos:altLabel>overdue EPF contribution</skos:altLabel>
    <skos:altLabel>contribution arrears</skos:altLabel>
    <skos:altLabel>delayed contribution penalty</skos:altLabel>
    <skos:altLabel>surcharge for late contribution</skos:altLabel>
    <skos:altLabel>failure to pay contribution on time</skos:altLabel>
    <skos:altLabel>missed EPF contribution deadline</skos:altLabel>
    <skos:altLabel>contribution overdue more than twelve months</skos:altLabel>
    <skos:altLabel>contribution late by ten days</skos:altLabel>
    <epf:relatedTo rdf:resource="http://example.org/epf#RecoveryOfUnpaidContributions"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#EmployeeContribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#ContributionRule"/>
    <rdfs:label>Normal Employee EPF Contribution</rdfs:label>
    <epf:definedIn rdf:resource="http://example.org/epf#Section10"/>
    <skos:altLabel>employee contribution rate</skos:altLabel>
    <skos:altLabel>employee EPF contribution percentage</skos:altLabel>
    <skos:altLabel>worker contribution percentage</skos:altLabel>
    <skos:altLabel>normal employee contribution</skos:altLabel>
    <skos:altLabel>8 percent employee contribution</skos:altLabel>
    <skos:altLabel>employee pays eight percent</skos:altLabel>
    <skos:altLabel>employee monthly EPF contribution</skos:altLabel>
  
    <epf:relatedTo rdf:resource="http://example.org/epf#ContributionRounding"/>
    <epf:relatedTo rdf:resource="http://example.org/epf#IndividualAccountCredit"/></rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#definedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>defined in</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/epf#ComplianceConcept"/>
    <rdfs:range rdf:resource="http://example.org/epf#LegalSection"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#EmployerLiabilityNonTransfer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#EmployerComplianceRule"/>
    <rdfs:label>Employer Cannot Transfer Own EPF Liability to Employee</rdfs:label>
    <epf:definedIn rdf:resource="http://example.org/epf#Section20"/>
    <skos:altLabel>employer cannot deduct own contribution from employee</skos:altLabel>
    <skos:altLabel>employer cannot deduct own surcharge from employee</skos:altLabel>
    <skos:altLabel>employer liability cannot be transferred to employee</skos:altLabel>
    <skos:altLabel>employer cannot shift EPF liability to employee</skos:altLabel>
    <skos:altLabel>contract transferring employer EPF liability is void</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#LegalAct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Legal Act</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#Section12">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#LegalSection"/>
    <rdfs:label>Section 12</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#ComplianceConcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Compliance Concept</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#Section19">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#LegalSection"/>
    <rdfs:label>Section 19</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#EmployerContribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#ContributionRule"/>
    <rdfs:label>Normal Employer EPF Contribution</rdfs:label>
    <epf:definedIn rdf:resource="http://example.org/epf#Section10"/>
    <skos:altLabel>employer contribution rate</skos:altLabel>
    <skos:altLabel>employer EPF contribution percentage</skos:altLabel>
    <skos:altLabel>normal employer contribution</skos:altLabel>
    <skos:altLabel>12 percent employer contribution</skos:altLabel>
    <skos:altLabel>employer pays twelve percent</skos:altLabel>
    <skos:altLabel>employer monthly EPF contribution</skos:altLabel>
    <epf:relatedTo rdf:resource="http://example.org/epf#EmployerLiabilityNonTransfer"/>
    <epf:relatedTo rdf:resource="http://example.org/epf#ProtectionFromEarningsReduction"/>
  
    <epf:relatedTo rdf:resource="http://example.org/epf#ContributionRounding"/>
    <epf:relatedTo rdf:resource="http://example.org/epf#IndividualAccountCredit"/></rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#HigherContributionElection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#ContributionRule"/>
    <rdfs:label>Election to Pay Higher EPF Contribution Percentages</rdfs:label>
    <epf:definedIn rdf:resource="http://example.org/epf#Section11"/>
    <skos:altLabel>higher contribution percentage</skos:altLabel>
    <skos:altLabel>higher EPF contribution rate</skos:altLabel>
    <skos:altLabel>elect higher contribution rate</skos:altLabel>
    <skos:altLabel>choose higher contribution percentage</skos:altLabel>
    <skos:altLabel>contribute above the normal rate</skos:altLabel>
    <skos:altLabel>pay more than the normal contribution rate</skos:altLabel>
    <skos:altLabel>voluntary higher EPF contribution</skos:altLabel>
    <skos:altLabel>increase EPF contribution percentage</skos:altLabel>
    <skos:altLabel>employee and employer elect higher contributions</skos:altLabel>
    <skos:altLabel>higher than section 10 contribution rate</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#PenaltyRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Penalty Rule</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/epf#ComplianceConcept"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#Section14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#LegalSection"/>
    <rdfs:label>Section 14</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#ReducedEarningsContribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#ContributionRule"/>
    <rdfs:label>Reduction of Earnings to Reduce EPF Contributions</rdfs:label>
    <epf:definedIn rdf:resource="http://example.org/epf#Section12"/>
    <skos:altLabel>reduce earnings to reduce contributions</skos:altLabel>
    <skos:altLabel>reduce salary to lower EPF contribution</skos:altLabel>
    <skos:altLabel>cut wages to avoid EPF contribution</skos:altLabel>
    <skos:altLabel>employer lowering salary to reduce EPF</skos:altLabel>
    <skos:altLabel>salary reduction to reduce contribution amount</skos:altLabel>
    <skos:altLabel>contribution shortfall caused by reduced earnings</skos:altLabel>
    <skos:altLabel>Commissioner directs payment of contribution difference</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#ProtectionFromEarningsReduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#EmployerComplianceRule"/>
    <rdfs:label>Protection Against Reducing Earnings or Benefits Because of EPF Liability</rdfs:label>
    <epf:definedIn rdf:resource="http://example.org/epf#Section19"/>
    <skos:altLabel>employer cannot reduce earnings because of EPF</skos:altLabel>
    <skos:altLabel>employer cannot reduce salary because of contribution liability</skos:altLabel>
    <skos:altLabel>employer cannot reduce benefits because of EPF surcharge</skos:altLabel>
    <skos:altLabel>protection from salary reduction due to EPF liability</skos:altLabel>
    <skos:altLabel>no detrimental change to employee benefits because of EPF</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#hasSection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has section</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/epf#LegalAct"/>
    <rdfs:range rdf:resource="http://example.org/epf#LegalSection"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#LegalSection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Legal Section</rdfs:label>
  </rdf:Description>
