<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:epf="http://example.org/epf#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/epf#MonthlyContributionPayment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#PaymentRule"/>
    <rdfs:label>Monthly EPF Contribution Deduction and Payment</rdfs:label>
    <epf:definedIn rdf:resource="http://example.org/epf#Section15"/>
    <skos:altLabel>monthly EPF payment</skos:altLabel>
    <skos:altLabel>deduct and pay employee contribution</skos:altLabel>
    <skos:altLabel>employer deducts employee contribution</skos:altLabel>
    <skos:altLabel>employer sends employee contribution to the Fund</skos:altLabel>
    <skos:altLabel>payment on behalf of employee</skos:altLabel>
    <skos:altLabel>monthly contribution payment deadline</skos:altLabel>
    <skos:altLabel>pay before the last day of the succeeding month</skos:altLabel>
    <skos:altLabel>employee contribution paid by employer</skos:altLabel>
    <epf:hasConsequence rdf:resource="http://example.org/epf#LateContributionSurcharge"/>
  
    <epf:relatedTo rdf:resource="http://example.org/epf#IndividualAccountCredit"/></rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#RecoveryOfUnpaidContributions">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#EnforcementRule"/>
    <rdfs:label>Recovery of Money Due to the EPF</rdfs:label>
    <epf:definedIn rdf:resource="http://example.org/epf#Section17"/>
    <skos:altLabel>recover unpaid EPF contributions</skos:altLabel>
    <skos:altLabel>recover money due to the Fund</skos:altLabel>
    <skos:altLabel>EPF debt recovery</skos:altLabel>
    <skos:altLabel>contributions recoverable as debt due to the State</skos:altLabel>
    <skos:altLabel>Commissioner recovers unpaid contributions</skos:altLabel>
    <skos:altLabel>recovery proceedings for EPF money</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/epf#EPFAct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/epf#LegalAct"/>
    <rdfs:label>Employees' Provident Fund Act, No. 15 of 1958</rdfs:label>
    <epf:hasSection rdf:resource="http://example.org/epf#Section10"/>
    <epf:hasSection rdf:resource="http://example.org/epf#Section11"/>
    <epf:hasSection rdf:resource="http://example.org/epf#Section12"/>
